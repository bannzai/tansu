{
  "name": "tansu",
  "version": "0.0.0",
  "private": true,
  "description": "Local Notion-like database / CMS with Web UI, CLI and MCP server",
  "type": "module",
  "bin": {
    "tansu": "./src/cli.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/cli.ts --compile --outfile dist/tansu"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
